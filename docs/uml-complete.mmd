    StatementValue --o EachStatement
    StatementValue --o WhileStatement
    StatementValue --o IfStatement
    IfStatement --o IfBranch
    IfBranch --o ElsePart
    IfBranch --o ElifPart
    IfStatement --o Block
    WhileStatement --o Block
    ElsePart --o Block
    ElifPart --o Block
    EachStatement --o Block
    FunctionDeclarationStatement --o Block
    TryCatch --o Block
    Block --o Statement
    Statement --o Region
    FunctionDeclarationStatement --o TypeSpecifier
    VariableDeclarationStatement --o TypeSpecifier
    Expression --o ExpressionValue
    Expression --o Region
    ExpressionValue --o AssignmentExpression
    ExpressionValue --o UpdateExpression
    AssignmentExpression --o AssignmentOperator
    UpdateExpression --o UpdateOperator
    BinaryExpression --o BinaryOperator
    ExpressionValue --o BinaryExpression
    ExpressionValue --o UnaryExpression
    ExpressionValue --o IdentifierExpression
    ExpressionValue --o FunctionCallExpression
    Parameter --o TypeSpecifier
    ExpressionValue --o IndexExpression
    UnaryExpression --o UnaryOperator
    AssignmentExpression --o Expression
    ReturnStatement --o Expression
    UpdateExpression --o Expression
    BinaryExpression --o Expression
